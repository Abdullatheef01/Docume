# Copy this file to ".env" and fill the values. Never commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/docume?retryWrites=true&w=majority
MONGODB_URI=

# Frontend URL allowed to call this API (CORS) and where login redirects back to.
# More than one? Separate with commas. The FIRST one is where login sends the browser back.
CLIENT_URL=http://localhost:5173

# This server's public URL (used to build the OAuth callback URLs)
SERVER_URL=http://localhost:5000

# Secret used to sign the login cookie (min 32 chars). Create one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth  (callback: http://localhost:5000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth  (callback: http://localhost:5000/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI mode + magic wand (Phase 4). Get a free key: aistudio.google.com > Get API key
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model name. "gemini-flash-latest" always points to the current Flash model.
# If you want a fixed one, copy the exact name from Google AI Studio.
GEMINI_MODEL=gemini-flash-latest
# Optional: when Gemini says "high demand" (503) the server retries 2 times. For the last try it can switch to
# another model. Copy the exact name from Google AI Studio, e.g. a Flash-Lite model. Leave empty to keep the same model.
GEMINI_FALLBACK_MODEL=
# Optional: seconds to wait for Gemini (ms). Raise it if you get "AI took too long" (504).
AI_TIMEOUT_MS=45000

# Optional: GitHub personal access token (no scopes needed). Makes reading repos / profiles
# for AI generate much more reliable (GitHub allows only 60 anonymous requests per hour).
GITHUB_TOKEN=

# Optional: a SECOND Gemini key used only by the magic wand. Create it in a different Google project
# (limits are per project, so this gives the wand its own quota). Leave empty to use GEMINI_API_KEY for both.
GEMINI_WAND_API_KEY=

# AI usage limits. Per user: LIMIT_* calls in every LIMIT_WINDOW_HOURS (the window starts at the first use).
# Whole site: SITE_DAILY_* calls per day (keep them a little under your Gemini daily limit).
LIMIT_WINDOW_HOURS=5
LIMIT_GENERATE=6
LIMIT_WAND=15
SITE_DAILY_GENERATE=1100
SITE_DAILY_WAND=1100

# ---- Production only (Render etc.) ----
# NODE_ENV=production
# Proxies in front of the server: 1 = Render only, 2 = Vercel rewrite (/api -> Render) + Render
# TRUST_PROXY=2
# 'lax' (default) is right when the browser only talks to your Vercel domain (rewrite). 'none' only if the
# frontend and the server are on different domains (needs https; some browsers block these cookies).
# COOKIE_SAMESITE=lax
